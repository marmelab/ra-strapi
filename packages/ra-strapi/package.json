{
  "name": "ra-strapi",
  "version": "2.0.0",
  "repository": "git@github.com:marmelab/ra-strapi.git",
  "author": "Guillaume BILLEY",
  "license": "MIT",
  "description": "Data provider for React Admin using Strapi",
  "files": [
    "*.md",
    "dist",
    "src"
  ],
  "type": "module",
  "zshy": {
    "exports": "./src/index.ts",
    "noEdit": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "dependencies": {
    "lodash": "^4.17.21",
    "qs": "^6.14.0"
  },
  "peerDependencies": {
    "react-admin": "^5.0.0"
  },
  "devDependencies": {
    "react-admin": "^5.0.0",
    "zshy": "^0.8.0"
  },
  "scripts": {
    "build": "zshy",
    "lint": "eslint --fix ./src"
  }
}
